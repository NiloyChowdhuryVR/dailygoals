datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SubjectProgress {
  id             String          @id @default(cuid())
  subjectId      String          @unique
  startDate      String
  isStarted      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedTasks CompletedTask[]
}

model CompletedTask {
  id                String   @id @default(cuid())
  subjectProgressId String
  topicId           String
  completedAt       DateTime @default(now())

  subjectProgress SubjectProgress @relation(fields: [subjectProgressId], references: [id], onDelete: Cascade)

  @@unique([subjectProgressId, topicId])
}

model CustomSubject {
  id          String   @id @default(cuid())
  subjectId   String   @unique
  title       String
  jsonContent String   @db.Text
  createdAt   DateTime @default(now())
}

model DeletedSubject {
  id        String   @id @default(cuid())
  subjectId String   @unique
  createdAt DateTime @default(now())
}

model TopicDocument {
  id        String   @id @default(cuid())
  subjectId String
  topicId   String
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, topicId])
}

model WorkflowTrashItem {
  id        String   @id @default(cuid())
  subjectId String   @unique
  title     String
  snapshot  String   @db.Text
  deletedAt DateTime @default(now())
}

model SavedResource {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String   @default("video")
  whyWatch  String?  @db.Text
  tags      String   @db.Text
  subjectId String?
  topicId   String?
  isWatched Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


